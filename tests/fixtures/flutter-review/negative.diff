+import 'dart:async';
+
+import 'package:flutter/material.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+
+import 'profile_repository.dart';
+
+class ProfileScreen extends StatefulWidget {
+  const ProfileScreen({super.key, required this.repository});
+
+  final ProfileRepository repository;
+
+  @override
+  State<ProfileScreen> createState() => _ProfileScreenState();
+}
+
+class _ProfileScreenState extends State<ProfileScreen>
+    with WidgetsBindingObserver {
+  final _nameController = TextEditingController();
+  StreamSubscription<int>? _ticker;
+
+  @override
+  void initState() {
+    super.initState();
+    WidgetsBinding.instance.addObserver(this);
+    _ticker = Stream<int>.periodic(const Duration(seconds: 1)).listen((_) {
+      if (mounted) {
+        setState(() {});
+      }
+    });
+  }
+
+  @override
+  void didChangeAppLifecycleState(AppLifecycleState state) {
+    if (state == AppLifecycleState.resumed) {
+      widget.repository.refresh();
+    }
+  }
+
+  Future<void> _loadProfile() async {
+    final profile = await widget.repository.loadProfile();
+    if (!mounted) return;
+    setState(() => _nameController.text = profile.name);
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final accent = Theme.of(context).colorScheme.primary;
+    return Scaffold(
+      appBar: AppBar(title: const Text('Profile')),
+      body: PopScope(
+        canPop: true,
+        onPopInvokedWithResult: (didPop, result) => _ticker?.pause(),
+        child: Center(child: TextField(controller: _nameController)),
+      ),
+    );
+  }
+
+  @override
+  void dispose() {
+    WidgetsBinding.instance.removeObserver(this);
+    _ticker?.cancel();
+    _nameController.dispose();
+    super.dispose();
+  }
+}
diff --git a/lib/profile_repository.dart b/lib/profile_repository.dart
new file mode 100644
--- /dev/null
+++ b/lib/profile_repository.dart
@@ -0,0 +1,47 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+
+class Profile {
+  const Profile({required this.name});
+
+  final String name;
+
+  factory Profile.fromJson(Map<String, dynamic> json) =>
+      Profile(name: json['name'] as String? ?? '');
+}
+
+class ProfileRepository {
+  ProfileRepository({HttpClient? client}) : _client = client ?? HttpClient() {
+    _client.connectionTimeout = const Duration(seconds: 10);
+  }
+
+  final HttpClient _client;
+  final _TokenStore _tokenStore = _TokenStore();
+
+  Future<Profile> loadProfile() async {
+    final token = await _tokenStore.read();
+    final request = await _client.getUrl(
+      Uri.https('api.example.com', '/profile', {'token': token}),
+    );
+    final response = await request.close();
+    if (response.statusCode != HttpStatus.ok) {
+      throw const HttpException('Profile request failed');
+    }
+    final body = await response.transform(utf8.decoder).join();
+    return Profile.fromJson(jsonDecode(body) as Map<String, dynamic>);
+  }
+
+  Future<void> refresh() => loadProfile();
+
+  void close() {
+    _client.close();
+  }
+}
+
+class _TokenStore {
+  final _storage = const FlutterSecureStorage();
+
+  Future<String?> read() => _storage.read(key: 'access_token');
+}
