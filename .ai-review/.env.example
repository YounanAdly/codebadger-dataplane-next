# === AI Review Environment Variables ===
# Copy this file to .env (in .ai-review/) for local testing only.
# NEVER commit .env. In CI, set these as encrypted secrets.

# ---- Provider selection ----
# One of: gemini | anthropic | openai | azure-openai | copilot
AI_REVIEW_PROVIDER=copilot

# ---- Gemini (current) ----
GEMINI_API_KEY=AQ.Ab8RN6IdXlqTbNc38A-oMuvYX0Iu3nfXKfBIYA_lRK5N2TrcHw

# ---- Anthropic Claude (future) ----
ANTHROPIC_API_KEY=

# ---- OpenAI (optional) ----
OPENAI_API_KEY=

# ---- Azure OpenAI (optional) ----
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ---- GitHub Copilot / GitHub Models (future - production) ----
# On GitHub Actions this is auto-populated as ${{ secrets.GITHUB_TOKEN }}
GITHUB_TOKEN=

# ---- Platform: GitHub (auto-injected by GitHub Actions) ----
# GITHUB_REPOSITORY, GITHUB_EVENT_PATH, GITHUB_SHA, GITHUB_BASE_REF, GITHUB_HEAD_REF, GITHUB_TOKEN

# ---- Platform: Azure DevOps (auto-injected by pipeline) ----
# SYSTEM_ACCESSTOKEN, SYSTEM_TEAMFOUNDATIONCOLLECTIONURI, SYSTEM_TEAMPROJECT,
# BUILD_REPOSITORY_ID, SYSTEM_PULLREQUEST_PULLREQUESTID,
# SYSTEM_PULLREQUEST_SOURCEBRANCH, SYSTEM_PULLREQUEST_TARGETBRANCH

# ---- Behaviour toggles ----
# 1 = do not post comments, just print findings (great for local testing)
AI_REVIEW_DRY_RUN=0
# 1 = do not fail the CI check even on critical findings (soft-launch mode)
AI_REVIEW_SOFT=0
